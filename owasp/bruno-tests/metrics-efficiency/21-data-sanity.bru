meta {
  name: [21] Data Sanity — Efficiency Values
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/auth/metrics/efficiency?start={{startTs}}&end={{endTs}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200", function() {
    expect(res.status).to.equal(200);
  });

  test("efficiency values are positive numbers", function() {
    if (res.body.log && res.body.log.length > 0) {
      for (const entry of res.body.log.slice(0, 5)) {
        expect(entry.efficiencyWThs).to.be.above(0);
      }
    }
  });

  test("avgEfficiencyWThs matches log average", function() {
    if (res.body.log && res.body.log.length > 0) {
      const total = res.body.log.reduce((sum, e) => sum + e.efficiencyWThs, 0);
      const expectedAvg = total / res.body.log.length;
      const diff = Math.abs(res.body.summary.avgEfficiencyWThs - expectedAvg);
      expect(diff).to.be.below(0.01);
    }
  });

  test("efficiency values are in reasonable range (1-200 W/TH)", function() {
    if (res.body.log && res.body.log.length > 0) {
      for (const entry of res.body.log.slice(0, 5)) {
        expect(entry.efficiencyWThs).to.be.above(0);
        expect(entry.efficiencyWThs).to.be.below(200);
      }
    }
  });

  test("log entries are sorted by timestamp", function() {
    if (res.body.log && res.body.log.length > 1) {
      for (let i = 1; i < res.body.log.length; i++) {
        expect(res.body.log[i].ts).to.be.above(res.body.log[i-1].ts);
      }
    }
  });
}
