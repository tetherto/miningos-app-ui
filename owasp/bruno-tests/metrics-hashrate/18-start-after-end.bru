meta {
  name: [18] Validation — Start After End
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/auth/metrics/hashrate?start={{endTs}}&end={{startTs}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 400 when start > end", function() {
    expect(res.status).to.be.oneOf([400, 500]);
  });

  test("error indicates invalid date range", function() {
    const body = JSON.stringify(res.body).toLowerCase();
    const hasError = body.includes('err_') || body.includes('invalid') || body.includes('range');
    expect(hasError).to.be.true;
  });
}
