meta {
  name: [17] Validation — Start After End
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/auth/finance/subsidy-fees?start={{endTs}}&end={{startTs}}&period=daily
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 400 when start > end", function() {
    expect(res.status).to.be.oneOf([400, 500]);
  });
}
