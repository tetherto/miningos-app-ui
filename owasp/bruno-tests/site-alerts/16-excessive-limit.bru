meta {
  name: [16] Resource — Excessive Limit
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/auth/alerts/site?offset=0&limit=50000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200 or 400 (should cap or reject large limit)", function() {
    expect(res.status).to.be.oneOf([200, 400]);
  });

  test("response time under 30s (no obvious resource exhaustion)", function() {
    expect(res.responseTime).to.be.below(30000);
  });
}
