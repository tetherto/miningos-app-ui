meta {
  name: [18] Functional — Container Filter
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/auth/metrics/power-mode/timeline?start={{startTs}}&end={{endTs}}&container={{containerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200 with container filter", function() {
    expect(res.status).to.equal(200);
  });

  test("response has expected shape", function() {
    expect(res.body).to.have.property('data');
  });

  test("response time under 10s", function() {
    expect(res.responseTime).to.be.below(10000);
  });
}
