meta {
  name: [23] Injection — NoSQL via Container Param
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/auth/metrics/power-mode/timeline?start={{startTs}}&end={{endTs}}&container={"$gt":""}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200 or 400 (NoSQL injection rejected)", function() {
    expect(res.status).to.be.oneOf([200, 400]);
  });

  test("does not return all miners (injection ignored)", function() {
    if (res.status === 200 && res.body.data) {
      const dataStr = JSON.stringify(res.body.data);
      expect(dataStr.length).to.be.below(100000);
    }
  });
}
