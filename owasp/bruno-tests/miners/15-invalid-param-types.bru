meta {
  name: [15] Validation — Invalid Param Types
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/auth/miners?offset=not_a_number&limit=not_a_number
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 400 when integer params receive strings", function() {
    expect(res.status).to.be.oneOf([400, 500]);
  });
}
